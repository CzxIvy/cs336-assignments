{
    "model": {
        "vocab_size": 10000,
        "context_length": 256,
        "d_model": 512,
        "num_layers": 4,
        "num_heads": 16,
        "d_ff": 1344,
        "rope_theta": 10000
    },
    "optimizer": {
        "lr": 0.00028,
        "max_learning_rate": 0.001,
        "min_learning_rate": 0.000014,
        "warmup_iters": 500,
        "cosine_cycle_iters": 10000,
        "weight_decay": 0.01,
        "clip_grad_norm": 1.0
    },
    "train": {
        "batch_size": 64,
        "train_steps": 6000,
        "val_interval": 100,
        "val_batches": 10,
        "save_interval": 1000,
        "log_interval": 1,
        "save_path": "./checkpoints/",
        "resume_checkpoint": 0
    }
}